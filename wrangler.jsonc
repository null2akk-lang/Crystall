{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystal-drop",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id on purpose: `wrangler deploy` creates the D1 database
  // automatically the first time. Tables are created by the Worker itself.
  "d1_databases": [{ "binding": "DB", "database_name": "crystal-drop" }],
  "observability": { "enabled": true }
}
